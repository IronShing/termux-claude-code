#!/data/data/com.termux/files/usr/bin/env bash
# termux-claude-code: bin/claude shim
#
# Resolves the package root from this script's real path (handles npm's global
# bin symlink), then exec's the upstream native binary via the bundled musl
# loader.
#
# If vendor/ is incomplete (postinstall didn't run, was --ignore-scripts'd, or
# failed silently) this shim runs install.js once on first invocation as a
# safety net. After bootstrap succeeds the vendor/ files persist and subsequent
# runs are zero-overhead.
set -euo pipefail

# Resolve script real path (follow symlinks). readlink -f is on Termux's coreutils.
if command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f "$0")"
else
  # Last-resort fallback if readlink is unavailable (shouldn't happen on Termux).
  SELF="$0"
fi
PKG_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

LOADER="$PKG_ROOT/vendor/musl/lib/ld-musl-aarch64.so.1"
LIBDIR="$PKG_ROOT/vendor/musl/lib"
BINARY="$PKG_ROOT/vendor/upstream-musl/claude"

# First-run bootstrap. Postinstall is best-effort — if it didn't complete, run
# install.js inline before serving the user's first command. This adds a one-time
# 1–2 minute delay (downloading ~225 MB) but only on the very first invocation.
if [ ! -x "$LOADER" ] || [ ! -f "$BINARY" ]; then
  echo "[termux-claude-code] vendor/ is incomplete — running first-run bootstrap..." >&2
  echo "[termux-claude-code] (this fetches ~225 MB; subsequent runs are instant)" >&2
  if ! command -v node >/dev/null 2>&1; then
    echo "[termux-claude-code] FATAL: 'node' not on PATH. Install with: pkg install nodejs" >&2
    exit 127
  fi
  if ! node "$PKG_ROOT/install.js"; then
    echo "" >&2
    echo "[termux-claude-code] Bootstrap failed. Run with --debug for detail:" >&2
    echo "    node \"$PKG_ROOT/install.js\" --debug" >&2
    echo "  Or check current state:" >&2
    echo "    node \"$PKG_ROOT/install.js\" --check" >&2
    exit 1
  fi
fi

# Defensive re-check: bootstrap claimed success but files might still be off.
if [ ! -x "$LOADER" ]; then
  echo "[termux-claude-code] FATAL: musl loader still missing after bootstrap: $LOADER" >&2
  echo "  This shouldn't happen — please file an issue with:" >&2
  echo "    node \"$PKG_ROOT/install.js\" --check" >&2
  exit 127
fi
if [ ! -f "$BINARY" ]; then
  echo "[termux-claude-code] FATAL: upstream binary still missing after bootstrap: $BINARY" >&2
  echo "    node \"$PKG_ROOT/install.js\" --check" >&2
  exit 127
fi

# Belt-and-braces auto-updater defense: even if ~/.claude/settings.json is
# missing or wrong, the env var still wins for code paths that read it.
export DISABLE_AUTOUPDATER="${DISABLE_AUTOUPDATER:-1}"

# CLAUDE_CODE_INSTALLED_VIA_NPM_WRAPPER is what upstream's cli-wrapper.cjs sets;
# we set it too so any upstream telemetry attribution stays accurate.
export CLAUDE_CODE_INSTALLED_VIA_NPM_WRAPPER="${CLAUDE_CODE_INSTALLED_VIA_NPM_WRAPPER:-1}"

# Termux preloads libtermux-exec-ld-preload.so for syscall shimming. It is
# linked against Bionic libc and references Bionic-internal symbols
# (__register_atfork, __strlen_chk, etc.) that musl does not provide. If we
# leave LD_PRELOAD set, musl's loader prints a wall of relocation errors
# trying (and failing) to load it. Unset before exec — our musl-loaded child
# does not need Termux's exec shim because we are launching via the loader
# directly, not via a Bionic exec*() that would need path translation.
unset LD_PRELOAD

exec "$LOADER" --library-path "$LIBDIR" "$BINARY" "$@"
